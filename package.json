{
  "name": "ai-resume-screener",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25 || >=26"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace @ai-resume-screener/server",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace @ai-resume-screener/server",
    "test": "npm run test --workspace @ai-resume-screener/server && npm run test --workspace client",
    "test:pg": "npm run test:pg --workspace @ai-resume-screener/server",
    "db:migrate": "npm run db:migrate --workspace @ai-resume-screener/server"
  },
  "description": "AI Resume Screener monorepo foundation"
}
