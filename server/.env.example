NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://resume_dev:resume_dev@localhost:5432/ai_resume_screener
# Unused by the current server. Leave blank. Rate limits are process-local.
REDIS_URL=
TRUST_PROXY=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite-preview
# Leave blank unless you intentionally call a live provider.
LLM_API_KEY=
# Total time for every provider attempt, backoff, and the one repair call.
# LLM_TIMEOUT_MS is accepted as this same deadline. It is not a per-attempt timeout.
LLM_DEADLINE_MS=15000
# Maximum provider calls inside one deadline, not extra retries after this number.
# LLM_MAX_RETRIES is accepted as this same attempt ceiling.
LLM_MAX_ATTEMPTS=2
LLM_MAX_INPUT_CHARS=80000
LLM_MAX_OUTPUT_CHARS=32000
LLM_MAX_OUTPUT_TOKENS=4096
# Local placeholder only. Production startup rejects this value.
JWT_SECRET=dev-only-not-a-secret-000000000000
AUTH_TOKEN_TTL=12h
FREE_TIER_MONTHLY_SCAN_LIMIT=5
# Admission lease. Keep this longer than the provider timeout.
SCAN_OPERATION_LEASE_MS=120000
# Terminal idempotency keys can be reused after this age. In-flight rows are kept.
IDEMPOTENCY_RETENTION_MS=86400000
PDF_PARSE_TIMEOUT_MS=8000
PDF_MAX_PAGES=20
PDF_MAX_EXTRACTED_CHARS=50000
PDF_MAX_CONCURRENT=2
